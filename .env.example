# Local development only. Spring reads this as a properties file, not a shell script.
spring.datasource.url=jdbc:postgresql://localhost:5432/conduit
spring.datasource.username=conduit
spring.datasource.password=replace-with-a-local-database-password
CONDUIT_JWT_SECRET=replace-with-base64-encoding-of-at-least-32-random-bytes

# Explicit demo opt-in; use a separate database and read docs/demo.md first.
# spring.profiles.active=demo
# spring.datasource.url=jdbc:postgresql://localhost:5432/conduit_demo
# CONDUIT_DEMO_DATABASE=conduit_demo
# CONDUIT_DEMO_PASSWORD=replace-with-a-demo-only-password-of-at-least-15-characters
